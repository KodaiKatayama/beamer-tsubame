% beamerthemetsubame.sty
% LuaLaTeX専用
\mode<presentation>

% ----------------------------------------------------------------------
% オプション
% ----------------------------------------------------------------------
% english：スライド全体を英文の行送りにする（\usetheme[english]{tsubame}）
\newif\iftsubame@english
\DeclareOptionBeamer{english}{\tsubame@englishtrue}
\ProcessOptionsBeamer

% ----------------------------------------------------------------------
% パッケージ
% ----------------------------------------------------------------------
\usepackage{luatexja}
\usepackage[no-math]{fontspec}
\usepackage[no-math]{luatexja-fontspec}
\usepackage{unicode-math}
\usepackage{setspace}
\usepackage{appendixnumberbeamer}
\usepackage{enumitem}
\usepackage{graphicx}
\usepackage{caption}
\usepackage{tikz}
\usepackage{silence}
\WarningFilter{enumitem}{Negative labelwidth}
\usetikzlibrary{positioning}
\usetikzlibrary{arrows.meta}

% ----------------------------------------------------------------------
% ベーステーマ
% ----------------------------------------------------------------------
\usetheme[block=fill, numbering=fraction]{metropolis}

% ----------------------------------------------------------------------
% 色
% ----------------------------------------------------------------------
% 東京科学大学のブランドカラー（https://www.isct.ac.jp/en/001/about/brand/logo）
% Science Blue：フレームタイトルの背景・本文
\definecolor{mDarkTeal}{HTML}{1C3177}
% サブカラー：プログレスバー・タイトル下の線
\definecolor{mLightBrown}{HTML}{7F96C2}
% エクステンディッドカラーのアクセント（https://design-system.isct.ac.jp/ja/brand/elements/color/color-system）：\alert
\definecolor{tsubameOrange}{HTML}{FF8732}
\setbeamercolor{progress bar}{fg=mLightBrown, bg=mLightBrown!50!black!30}
\setbeamercolor{alerted text}{fg=tsubameOrange}
% エクステンディッドカラーのバックグラウンド：block・tsubamebox の地
\definecolor{tsubameBgDark}{HTML}{E8EAF1}
\definecolor{tsubameBgLight}{HTML}{F2F4F9}
\setbeamercolor{block title}{fg=mDarkTeal, bg=tsubameBgDark}
\setbeamercolor{block body}{bg=tsubameBgLight}

% ----------------------------------------------------------------------
% 欧文フォント
% ----------------------------------------------------------------------
\setmainfont[
    BoldFont=NotoSansCJKjp-Bold,
    LightFont=NotoSansCJKjp-Light,
    ItalicFont=NotoSans-MediumItalic,
    SmallCapsFont=NotoSansCJKjp-Regular,
]{NotoSansCJKjp-Regular}
\setsansfont[
    BoldFont=NotoSansCJKjp-Bold,
    LightFont=NotoSansCJKjp-Regular,
    ItalicFont=NotoSans-MediumItalic,
    SmallCapsFont=NotoSansCJKjp-Regular,
]{NotoSansCJKjp-Regular}

% ----------------------------------------------------------------------
% 和文フォント
% ----------------------------------------------------------------------
\setmainjfont[
    BoldFont=NotoSansCJKjp-Bold,
    LightFont=NotoSansCJKjp-Light,
]{NotoSansCJKjp-Regular}
\setsansjfont[
    BoldFont=NotoSansCJKjp-Bold,
    LightFont=NotoSansCJKjp-Light,
]{NotoSansCJKjp-Regular}

% ----------------------------------------------------------------------
% 数式フォント
% ----------------------------------------------------------------------
\setmathfont{NewComputerModernMath}
\setmathfontface{\mathrm}{NewComputerModernMath}

% ----------------------------------------------------------------------
% その他設定
% ----------------------------------------------------------------------
\urlstyle{same}

% ----------------------------------------------------------------------
% 行送り
% ----------------------------------------------------------------------
% 行間（行と行の隙間）を和文の文字サイズ（1\zw）の0.7倍にする．
% 和文は欧文の0.962216倍で組まれるので，行送りは文字サイズの 1.7 × 0.962216 ≒ 1.6358 倍．
% 文字サイズの指定ごとに行送りを計算し直すので，\large なども同じ比率になる．
% 英文は LaTeX 標準の行送り（本文で文字サイズの約1.24倍）のまま．
\renewcommand{\baselinestretch}{1}
\let\tsubame@setfontsize\@setfontsize
\def\@setfontsize#1#2#3{%
  \iftsubame@english
    \tsubame@setfontsize#1{#2}{#3}%
  \else
    \tsubame@setfontsize#1{#2}{1.6358\dimexpr #2pt\relax}%
  \fi
  % 和文の字間：その文字サイズの5%（欧文には入らない）
  \ltjsetparameter{kanjiskip={0.05\zw plus 0.4pt minus 0.5pt}}}

% 英文の段落：\begin{english} ... \end{english}
\newenvironment{english}{%
  \par\tsubame@englishtrue\@currsize
}{%
  \par
}

% ----------------------------------------------------------------------
% タイトルページ
% ----------------------------------------------------------------------
% 日付の既定値はコンパイルした日．発表日は \date{2026/10/27} のように指定する
\date{\the\year/\the\month/\the\day}
% 左右の余白は本文より広く，和文4文字分（4 × 0.962216 × 10.95pt ≒ 42.15pt，約14.8mm）
\newlength{\tsubame@titlemargin}
\setlength{\tsubame@titlemargin}{42.15pt}
% タイトルとフレームタイトルは1つのまとまりとして読むので，行間を本文より詰める．
% 行送りを和文の文字サイズの何倍にするか（1.4 なら行間 0.4 文字分）
\newcommand{\tsubame@headlinefeed}{1.4}
\setbeamertemplate{title}{
  \raggedright%
  \setlength{\baselineskip}{\tsubame@headlinefeed\zw}%
  \inserttitle%
  \par%
  \vspace*{0.5em}
}
% metropolis の並びを 著者 → 所属 → 日付 に変える（左揃え）
\setbeamertemplate{title page}{
  \hspace*{\dimexpr\tsubame@titlemargin-\beamer@leftmargin\relax}%
  \begin{minipage}[b][\paperheight]{\dimexpr\paperwidth-2\tsubame@titlemargin\relax}
    \ifx\inserttitlegraphic\@empty\else\usebeamertemplate*{title graphic}\fi
    \vfill%
    \ifx\inserttitle\@empty\else\usebeamertemplate*{title}\fi
    \ifx\insertsubtitle\@empty\else\usebeamertemplate*{subtitle}\fi
    \usebeamertemplate*{title separator}
    \ifx\beamer@shortauthor\@empty\else\usebeamertemplate*{author}\fi
    \ifx\insertinstitute\@empty\else\usebeamertemplate*{institute}\fi
    \ifx\insertdate\@empty\else\usebeamertemplate*{date}\fi
    \vfill
    \vspace*{1mm}
  \end{minipage}
}

% ----------------------------------------------------------------------
% フレームタイトルのサイズ
% ----------------------------------------------------------------------
\setbeamerfont{frametitle}{size=\Large}

% ----------------------------------------------------------------------
% 左右の余白
% ----------------------------------------------------------------------
% 本文の和文2文字分（2 × 0.962216 × 10.95pt ≒ 21.07pt，約7.4mm）
\newlength{\tsubame@margin}
\setlength{\tsubame@margin}{21.07pt}
\setbeamersize{text margin left=\tsubame@margin, text margin right=\tsubame@margin}
% フレームタイトルの文字も本文と同じ左端に揃える（上下の空きは metropolis のまま）
\defbeamertemplate{frametitle}{tsubame}{%
  \nointerlineskip%
  \begin{beamercolorbox}[%
      wd=\paperwidth,%
      sep=0pt,%
      leftskip=\tsubame@margin,%
      rightskip=\tsubame@margin,%
    ]{frametitle}%
  \setlength{\baselineskip}{\tsubame@headlinefeed\zw}%
  % metropolis の \metropolis@frametitlestrut@start は後ろに空白が入り1行目だけ右にずれるので，同じ支柱をここで書く
  \rule{0pt}{\metropolis@frametitle@padding+\totalheightof{X}}%
  \insertframetitle%
  \nolinebreak%
  \metropolis@frametitlestrut@end%
  \end{beamercolorbox}%
}
\setbeamertemplate{frametitle}[tsubame]

% ----------------------------------------------------------------------
% カスタムコマンド
% ----------------------------------------------------------------------
% ▶︎見出し
\newcommand{\subsectionhead}[1]{\textbf{\large ▶︎#1}}

% ----------------------------------------------------------------------
% カスタム環境
% ----------------------------------------------------------------------
% 大きめdescription（概要・まとめスライド用）
\newenvironment{myitemlarge}{%
  \begin{description}[style=nextline, font=\Large\bfseries, leftmargin=0pt, itemsep=3ex]
}{%
  \end{description}
}

% 普通サイズdescription（詳細スライド用）
\newenvironment{myitem}{%
  \begin{description}[style=nextline, font=\large\bfseries, leftmargin=0pt, itemsep=1ex]
}{%
  \end{description}
}

% ----------------------------------------------------------------------
% tikzスタイル
% ----------------------------------------------------------------------
\tikzset{
  tsubamebox/.style={
    fill=tsubameBgDark,
    rounded corners,
    text height=15pt,
    text depth=8pt,
    inner xsep=10pt,
    minimum width=4cm,
    minimum height=1cm,
  },
  tsubamearrow/.style={
    ->,
    line width=6pt,
    draw=mLightBrown!50,
    fill=mLightBrown!50,
    shorten >=7pt,
    shorten <=7pt,
    >={Triangle[length=4mm, width=7mm]}
  }
}

\mode<all>